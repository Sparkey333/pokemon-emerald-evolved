{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pokemon Emerald Evolved",
  "version": "0.1.0",
  "identifier": "com.darkhearts.emeraldevolved",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pokemon Emerald Evolved",
        "label": "main",
        "width": 1180,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#070b14"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: data: blob:; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://raw.githubusercontent.com ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Games",
    "copyright": "© 2026 DarkHearts",
    "shortDescription": "Official vs DIY evolved starter showcase for Emerald.",
    "longDescription": "Pokémon Emerald: Evolved wraps the Official vs DIY starter evolution showcase in a native app — community-researched Pokémon Evolved lines plus our stone-branch alternate forms for the Emerald ROM hack.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    }
  }
}
