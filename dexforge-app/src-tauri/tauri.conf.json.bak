{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Indigo Dexforge",
  "version": "0.2.0",
  "identifier": "com.darkhearts.indigodexforge",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Indigo Dexforge",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#080b14",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "© 2026 DarkHearts",
    "shortDescription": "Sprite vault, sheets and animations",
    "longDescription": "Indigo Dexforge — the Pokémon Evolved ROM-hack sheet forge. Browse the sprite vault, every character and action sheet, and play sprite animations. Local reference vault only; original species are the shippable ones.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  }
}
